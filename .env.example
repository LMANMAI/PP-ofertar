# ─────────────────────────────────────────────────────────────
# OfertAR — Variables de entorno
# Copiar este archivo a .env y completar con los valores reales:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── MySQL ──

# Host del servicio de base de datos
# Local (docker-compose): db
# EasyPanel: nombre del servicio de MySQL (ej. mysql-ofertar)
DB_HOST=localhost

# Puerto de MySQL
DB_PORT=3306

# Nombre de la base de datos
DB_NAME=ofertar_db

# Usuario de MySQL
DB_USER=root

# Contraseña de MySQL
# (también se usa como MYSQL_ROOT_PASSWORD en docker-compose)
DB_PASSWORD=cambiar_en_produccion

# ── JWT ──

# Clave secreta para firmar tokens JWT
# Mínimo 32 caracteres. Generar una nueva con:
#   openssl rand -base64 48
JWT_SECRET=cambiar_en_produccion

# ── OCR Service ──

# URL del servicio de OCR para procesamiento de tickets
OCR_SERVICE_URL=https://ocr-api-ofertar-ocr-ofertar.qr2vg3.easypanel.host

# Credenciales del servicio OCR
OCR_USERNAME=admin
OCR_PASSWORD=changeme

# Timeout en segundos para las llamadas al OCR (el procesamiento puede tardar)
OCR_TIMEOUT=120
