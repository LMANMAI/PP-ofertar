# ─────────────────────────────────────────────────────────────
# OfertAR — Variables de entorno
# Copiar este archivo a .env y completar con los valores reales:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── MySQL ──

# Host del servicio de base de datos
# Local (docker-compose): db
# EasyPanel: nombre del servicio de MySQL (ej. mysql-ofertar)
DB_HOST=localhost

# Puerto de MySQL
DB_PORT=3306

# Nombre de la base de datos
DB_NAME=ofertar_db

# Usuario de MySQL
DB_USER=root

# Contraseña de MySQL
# (también se usa como MYSQL_ROOT_PASSWORD en docker-compose)
DB_PASSWORD=cambiar_en_produccion

# ── JWT ──

# Clave secreta para firmar tokens JWT
# Mínimo 32 caracteres. Generar una nueva con:
#   openssl rand -base64 48
JWT_SECRET=cambiar_en_produccion

# ── OCR Service ──

# URL del servicio de OCR para procesamiento de tickets
OCR_SERVICE_URL=https://ocr-api-ofertar-ocr-ofertar.qr2vg3.easypanel.host

# Credenciales del servicio OCR
OCR_USERNAME=admin
OCR_PASSWORD=cambiar_en_produccion

# Timeout en segundos para las llamadas al OCR (el procesamiento puede tardar)
OCR_TIMEOUT=120

# ── Offer Scraper Service ──

# URL del microservicio de scraping de ofertas (Carrefour, etc.)
OFFER_SERVICE_URL=http://localhost:3000

# ── Tickets ──

# Cantidad máxima de tickets que se retienen por usuario (se borra el más
# viejo al superar este número). Antes era un valor fijo de 3 en el código.
TICKET_MAX_PER_USER=50

# ── SEPA (precios de supermercados, datos.produccion.gob.ar) ──

# Todas opcionales: sin ninguna, el snapshot baja el dataset de CKAN en vivo
# (lunes 3 AM). El sitio responde 403 a IPs de datacenter, así que hay fuentes
# alternativas. Se usa la primera seteada, en este orden:
#   1. SEPA_RESOURCE_FILE: un zip fijo dentro del contenedor. Gana siempre.
#   2. SEPA_RESOURCE_DIR: carpeta vigilada; toma el zip más reciente (por la
#      fecha de su contenido). La llena tools/sepa-relay. Montarla como volumen.
#   3. SEPA_RESOURCE_URL: un zip espejo http/https.
# SEPA_RESOURCE_FECHA (YYYY-MM-DD) sólo hace falta con FILE o URL cuando el zip
# no la trae adentro; con SEPA_RESOURCE_DIR se ignora.
# SEPA_RESOURCE_FILE=/data/sepa/sepa_martes.zip
# SEPA_RESOURCE_DIR=/data/sepa-incoming
# SEPA_RESOURCE_URL=https://espejo.ejemplo.com/sepa_2026-09-15.zip
# SEPA_RESOURCE_FECHA=2026-09-15

# Cron del snapshot (Spring, 6 campos, hora Argentina). Por defecto semanal.
# Con SEPA_RESOURCE_DIR conviene cada hora: en ese modo el cron se saltea si el
# zip más nuevo ya está cargado.
# SEPA_SYNC_CRON=0 20 * * * *

# ── Perfil ──

# Solo en desarrollo local: activa show-sql, Swagger (/docs) y el código de
# recuperación de contraseña en el log. NO definir en producción.
# SPRING_PROFILES_ACTIVE=dev

# ── CORS ──

# Solo si se sirve un cliente web (ej. Expo web). Coma-separado. Vacío = ninguno;
# la app móvil no usa CORS.
# CORS_ALLOWED_ORIGINS=https://app.ejemplo.com
